// Settings for main.nf. Edit the `params` block below for your site; per-run values (--release,
// --gate_passed true) go on the command line. There is no params file.
//
// Where it runs is decided by the profile:
//   (none)         the default profile `standard` below: SLURM + Apptainer, generic
//   <institution>  a profile from nf-core/configs (see the end of this file), which brings its own
//                  executor, queue, limits and container engine. It replaces `standard`.
//   local          no SLURM, no containers: -stub-run on a laptop

manifest {
    name            = 'osmo_refdb-hpc'
    description     = 'osmo_refdb canonical build, catalog, BacDive and NaCl model on SLURM + Apptainer'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'   // topic channels (versions)
}

params {
    // ---- your site: edit these here
    repo            = "${projectDir}"   // the clone to build in (this one); jobs read and write it, so it must be on shared storage
    reuse_refs_from = 'releases/v10'   // the snapshot to build from (relative to repo)
    families_file   = "${projectDir}/families.yaml"   // the families to build
    catalog_genes   = null     // EDIT: <dir>/GMGC10.human-gut.95nr.0.5.percent.prevalence.fna.gz, absolute path
    full_index_dir  = null     // EDIT: where the full catalog index goes, absolute path

    // ---- per run, on the command line
    release         = null     // --release <name>: the NEW release's name; releases/<release> must not exist yet

    // ---- with defaults
    outdir             = 'results'                     // -entry profile_samples writes <outdir>/profile
    publish_dir_mode   = 'copy'                        // how results are published (releases/<release>, <outdir>)
    catalog_name       = 'gmgc_gut'
    catalog_source     = 'GMGC v1.0 human gut, prevalence > 0.5% (Ducarmon et al., Cayman)'
    catalog_source_url = 'https://zenodo.org/records/10473258'
    catalog_force      = false
    data_dir           = 'data/phenotype_validation'   // where the BacDive tables and batches are published, under repo
    bacdive_full       = false                         // false: the BacDive analysis on the 43 pilot strains; true: the full BacDive set, the salt-in control and the NaCl model
    random_panel       = null                          // a random-panel pool to use (a directory with pool.hmm, pool_families.tsv); null: built (RANDOM_POOL)
    bacdive_snapshot   = null                          // harvested BacDive batches to start from (a bacdive_raw/ directory, e.g. <repo>/<data_dir>/bacdive_raw); reproduces that table
    nchunks            = 40                            // tasks per per-genome step
    split_mode         = 'random'                      // random | taxonomy
    gate_passed        = false                         // true: also run BacDive + the NaCl model
    samples            = null                          // -entry profile_samples: CSV with id,r1,r2
    reference_genomes_dir = null                       // osmotool's test_genomes/ (the nine reference genomes, *.fna)
    test_genomes_dir   = null                          // genomes with curated target genes; default <repo>/test_genomes
    recall_read_pairs  = 20000                         // wgsim read pairs per genome for the recall check


    // ---- the cluster (used by the default profile; an institutional profile sets its own)
    queue          = null      // SLURM partition; null = the cluster's default
    slurm_extra    = ''        // e.g. '--account=myproject --qos=normal'
    extra_binds    = ''        // comma-separated directories containers must see besides projectDir and the work directory
    work_dir       = null      // Nextflow's work directory; null = ./work (use scratch if repo is in $HOME)

    // ---- institutional profiles (nf-core/configs), pinned to a commit so a rerun does not depend on
    // a file that moves; to update, change the commit. Needs the network when Nextflow starts;
    // --custom_config_base can point at a local clone of nf-core/configs, NXF_OFFLINE=true skips it.
    custom_config_version = '0a2d887d8373bbf0746abd3eb3c4b0ca686c825f'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

workDir = params.work_dir ?: "${launchDir}/work"

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Containers see the pipeline's own code (projectDir: the modules' templates, its git checkout), the work
// directory (inputs are staged as links to other tasks' outputs, and some outputs hold links of their
// own), and extra_binds; inputs outside those, such as snapshots, are mounted by autoMounts.
// --no-mount hostfs: sites that set `mount hostfs = yes` in apptainer.conf (Snellius does) mount every
// host filesystem into the container, the host's /opt over the image's: the osmotool image's tools live
// in /opt/conda, and every step in it would fail with "command not found".
apptainer   { runOptions = "--no-mount hostfs --bind ${projectDir},${params.work_dir ?: "${launchDir}/work"}" + (params.extra_binds ? ",${params.extra_binds}" : '') }
singularity { runOptions = "--no-mount hostfs --bind ${projectDir},${params.work_dir ?: "${launchDir}/work"}" + (params.extra_binds ? ",${params.extra_binds}" : '') }

// Images without a registry in their name (biocontainers/...) come from quay.io, as in nf-core; the
// osmotool image names docker.io itself.
apptainer.registry   = 'quay.io'
singularity.registry = 'quay.io'
docker.registry      = 'quay.io'
podman.registry      = 'quay.io'


// Per invocation, a trace (with each task's image, peak memory and time: what to tighten the numbers in
// conf/base.config with), a timeline and a report, so the run after the gate does not overwrite the first.
trace {
    enabled = true
    file    = "pipeline_info/${java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyyMMdd-HHmmss'))}.trace.tsv"
    fields  = 'task_id,name,container,status,exit,submit,realtime,cpus,%cpu,memory,peak_rss,peak_vmem'
}
timeline {
    enabled   = true
    overwrite = false
    file      = "pipeline_info/${java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyyMMdd-HHmmss'))}.timeline.html"
}
report {
    enabled   = true
    overwrite = false
    file      = "pipeline_info/${java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyyMMdd-HHmmss'))}.report.html"
}

profiles {
    // generic SLURM + Apptainer; used when no -profile is given
    standard {
        apptainer {
            enabled    = true
            autoMounts = true
        }
        process {
            executor       = 'slurm'
            queue          = params.queue
            clusterOptions = params.slurm_extra
        }
    }

    // no SLURM, no container engine: for -stub-run on a laptop or for developing the workflow
    local {
        process {
            executor       = 'local'
            resourceLimits = [cpus: 4, memory: 6.GB, time: 1.h]   // fit a laptop VM
        }
    }
}

// Institutional profiles from nf-core/configs: `-profile <your institution>` sets the executor, queue,
// resource limits and container engine for a site, in place of `standard` above.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Settings for main.nf. Edit the `params` block below for your site; per-run values (--release,
// --outdir, --refs_store, ...) go on the command line. There is no params file.
//
// Where it runs is decided by the profile:
//   (none)         the default profile `standard` below: SLURM + Apptainer, generic
//   <institution>  a profile from nf-core/configs (see the end of this file), which brings its own
//                  executor, queue, limits and container engine. It replaces `standard`.
//   local          no SLURM, no containers: -stub-run on a laptop

manifest {
    name            = 'osmo_refdb-hpc'
    description     = 'osmo_refdb canonical build, catalog, BacDive and NaCl model on SLURM + Apptainer'
    mainScript      = 'main.nf'
    nextflowVersion = '>=25.04.0'   // topic channels (versions)
}

params {
    // ---- your site: edit these here
    families_file   = "${projectDir}/families.yaml"   // the families to build
    markers_file    = "${projectDir}/markers.yaml"   // the marker genes for the release's markers/
    catalog_genes   = null     // EDIT: <dir>/GMGC10.human-gut.95nr.0.5.percent.prevalence.fna.gz, absolute path

    // ---- per run, on the command line
    outdir          = null     // --outdir <dir>: the release folder, on shared storage (-entry profile_samples: its output)
    release         = null     // --release <name>: the release's name (v10), written into its PROVENANCE.json, catalog and NaCl model

    // ---- with defaults
    publish_dir_mode   = 'copy'                        // how results are published (under <outdir>)
    catalog_name       = 'gmgc_gut'
    catalog_source     = 'GMGC v1.0 human gut, prevalence > 0.5% (Ducarmon et al., Cayman)'
    catalog_source_url = 'https://zenodo.org/records/10473258'
    catalog_force      = false
    data_dir           = 'bacdive_data'                // where the BacDive tables and batches are published, under outdir
    bacdive_full       = false                         // false: the BacDive analysis on the 43 pilot strains; true: the full BacDive set, the salt-in control and the NaCl model
    bacdive_pilot      = null                          // the strain table of the default BacDive run; null: assets/bacdive/pilot_strains.tsv
    random_background_n = 5000                         // proteins in the benchmark's random bacterial background
    bacdive_snapshot   = null                          // harvested BacDive batches to start from (a bacdive_raw/ directory, e.g. <outdir>/<data_dir>/bacdive_raw); reproduces that table
    nchunks            = 40                            // tasks per per-genome step
    split_mode         = 'random'                      // random | taxonomy
    refs_store         = null                          // keep the UniProt fetch here, per family, and reuse it in the same UniProt release; null: every build fetches
    read_lengths       = null                          // the test reads at these lengths too, e.g. '100,150,250,300' (wgsim): summary_by_read_length.tsv
    background_r1      = null                          // a real metagenome (R1, R2) with no known osmoadaptation genes, scored as background
    background_r2      = null                          //   in the test benchmark: background_fpr.tsv
    diamond_min_subject_cover = 0.0                    // the benchmark's osmotool profile --min_subject_cover (0: off, osmotool's default)
    // the report-level rule, set per mode: profile on the calibration reads, annotate on the calibration proteins
    profile_min_report_f1      = 0.5                   // profile: the f1_all a unit must reach on the calibration reads
    profile_min_eval_positives = 20                    // profile: distinct positive calibration sequences a unit needs before the rule decides on it; below it, none for insufficient_evidence (0: off)
    profile_min_cascade_gain   = 0.01                  // profile cascade: the smallest calibration gain in f1_all that switches the HMM second opinion on
    profile_decision_support   = 0.9                   // profile: the fraction of bootstrap resamples a level, and the cascade's gain, must hold in
    profile_decision_bootstrap = 1000                  // profile: cluster-bootstrap resamples (source sequences) behind each decision; 0: point estimates alone
    annotate_min_report_f1      = 0.5                  // annotate (hmm): the f1_all a unit must reach on the calibration proteins
    annotate_min_eval_positives = 20                   // annotate: positive calibration proteins a unit needs before the rule decides on it (0: off)
    annotate_decision_support   = 0.9                  // annotate: the fraction of bootstrap resamples a level must hold in
    annotate_decision_bootstrap = 1000                 // annotate: protein-bootstrap resamples behind each level; 0: point estimates alone
    decision_bootstrap_seed     = 42                   // both modes' decision bootstrap seed
    samples            = null                          // -entry profile_samples: CSV with id,r1,r2
    db                 = null                          // -entry profile_samples: the release folder to profile with
    reference_genomes_dir = null                       // osmotool's test_genomes/ (the nine reference genomes, *.fna)
    test_genomes_dir   = null                          // genomes with curated target genes; default assets/test_genomes
    recall_read_pairs  = 20000                         // wgsim read pairs per genome for the recall check


    // ---- the cluster (used by the default profile; an institutional profile sets its own)
    queue          = null      // SLURM partition; null = the cluster's default
    slurm_extra    = ''        // e.g. '--account=myproject --qos=normal'
    work_dir       = null      // Nextflow's work directory; null = ./work (use scratch if launching from $HOME)

    // ---- institutional profiles (nf-core/configs), pinned to a commit so a rerun does not depend on
    // a file that moves; to update, change the commit. Needs the network when Nextflow starts;
    // --custom_config_base can point at a local clone of nf-core/configs, NXF_OFFLINE=true skips it.
    custom_config_version = '0a2d887d8373bbf0746abd3eb3c4b0ca686c825f'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

workDir = params.work_dir ?: "${launchDir}/work"

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// Containers see the pipeline's own code (projectDir: the modules' templates, its git checkout) and the
// work directory (inputs are staged as links to other tasks' outputs, and some outputs hold links of their
// own); every input given as a parameter is mounted by autoMounts. Outputs are published, and storeDir
// filled, by Nextflow itself, outside the containers.
// --no-mount hostfs: sites that set `mount hostfs = yes` in apptainer.conf (Snellius does) mount every
// host filesystem into the container, the host's /opt over the image's: the osmotool image's tools live
// in /opt/conda, and every step in it would fail with "command not found".
apptainer   { runOptions = "--no-mount hostfs --bind ${projectDir},${params.work_dir ?: "${launchDir}/work"}" }
singularity { runOptions = "--no-mount hostfs --bind ${projectDir},${params.work_dir ?: "${launchDir}/work"}" }

// Images without a registry in their name (biocontainers/...) come from quay.io, as in nf-core; the
// osmotool image names docker.io itself.
apptainer.registry   = 'quay.io'
singularity.registry = 'quay.io'
docker.registry      = 'quay.io'
podman.registry      = 'quay.io'


// Per invocation, a trace (with each task's image, peak memory and time: what to tighten the numbers in
// conf/base.config with), a timeline and a report, so a -resume does not overwrite the first run's.
trace {
    enabled = true
    file    = "pipeline_info/${java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyyMMdd-HHmmss'))}.trace.tsv"
    fields  = 'task_id,name,container,status,exit,submit,realtime,cpus,%cpu,memory,peak_rss,peak_vmem'
}
timeline {
    enabled   = true
    overwrite = false
    file      = "pipeline_info/${java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyyMMdd-HHmmss'))}.timeline.html"
}
report {
    enabled   = true
    overwrite = false
    file      = "pipeline_info/${java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyyMMdd-HHmmss'))}.report.html"
}

profiles {
    // generic SLURM + Apptainer; used when no -profile is given
    standard {
        apptainer {
            enabled    = true
            autoMounts = true
        }
        process {
            executor       = 'slurm'
            queue          = params.queue
            clusterOptions = params.slurm_extra
        }
    }

    // SURF's Snellius (-profile snellius), as osmoflow has it: SLURM on the genoa partition, Singularity
    // (with this file's runOptions: --no-mount hostfs and the binds).
    snellius {
        process {
            executor       = 'slurm'
            clusterOptions = '-p genoa'
        }
        executor {
            name            = 'slurm'
            queueSize       = 70
            submitRateLimit = '10 sec'
            jobName         = {
                n = "${task.name}" -> n.replaceAll( '[():\\s]', '_')
            }
        }
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = false
        docker.enabled         = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
        apptainer.enabled      = false
    }

    // Singularity/Apptainer on the machine Nextflow runs on, no SLURM (-profile test,singularity, the
    // stub test). Even a stub runs in each step's container: the version outputs read its tools.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // no SLURM: the local executor, sized for a laptop VM; add a container engine (local,singularity)
    local {
        process {
            executor       = 'local'
            resourceLimits = [cpus: 4, memory: 6.GB, time: 1.h]   // fit a laptop VM
        }
    }

    // a whole release, for real, on small inputs (assets/test/README.md): five families, three markers,
    // a 6,531-gene slice of the gut catalog and 14 BacDive strains. Combine
    // with the cluster's profile (-profile test,snellius); tests/check_performance.py scores the result.
    test {
        params {
            release             = 'test'
            families_file       = "${projectDir}/assets/test/families.yaml"
            markers_file        = "${projectDir}/assets/test/markers.yaml"
            catalog_genes       = "${projectDir}/assets/test/catalog/GMGC10.human-gut.95nr.0.5.percent.prevalence.fna.gz"
            bacdive_pilot       = "${projectDir}/assets/test/pilot_strains.tsv"
            random_background_n = 500
            nchunks             = 1
        }
        process {
            resourceLimits = [cpus: 16, memory: 64.GB, time: 4.h]
        }
    }
}

// Institutional profiles from nf-core/configs: `-profile <your institution>` sets the executor, queue,
// resource limits and container engine for a site, in place of `standard` above.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

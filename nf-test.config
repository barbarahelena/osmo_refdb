// nf-test: the pipeline tests in tests/ (tests/README.md). Default profile test,singularity (the test
// inputs, containers on this machine); the real run on a cluster: nf-test test --tag real --profile test,snellius
config {
    testsDir   "tests"
    workDir    System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "tests/nextflow.config"
    profile    "test,singularity"
}

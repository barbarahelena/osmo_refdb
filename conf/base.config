// Resources. The labels are the nf-core resource classes (cut to what this pipeline needs); the steps
// below them carry the values the old sbatch scripts had: measured on the laptop where a measurement
// exists, scaled from it otherwise (basis: docs/hpc.md). A task killed for memory or time is retried
// with more (x attempt); the release build is the exception, since a failed build leaves a partial release.

process {
    cpus          = 1
    memory        = { 4.GB * task.attempt }
    time          = { 1.h * task.attempt }
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 271] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: process_single { cpus = 1 }
    withLabel: process_low    { cpus = 2 }
    withLabel: process_medium { cpus = 4;  memory = { 8.GB * task.attempt };  time = { 2.h * task.attempt } }
    withLabel: process_high   { cpus = 8;  memory = { 16.GB * task.attempt }; time = { 4.h * task.attempt } }

    withName: CATALOG_FETCH    { memory = 4.GB;                           time = { 4.h * task.attempt } }
    withName: BACDIVE_HARVEST  { memory = 4.GB;                time = { 4.h * task.attempt } }
    withName: BACDIVE_GENOMES  { cpus = 8;  memory = 8.GB;     time = { 4.h * task.attempt } }
    withName: OSMOTOOL_INDEXCATALOG {  memory = { 32.GB * task.attempt };       time = { 6.h * task.attempt } }
    withName: BACDIVE_PROTEINS { cpus = 4;  memory = { 8.GB * task.attempt };  time = { 2.h * task.attempt } }
    withName: 'DIAMOND_MAKEDB|BENCHMARK_READS_CALIB|BENCHMARK_READS_TEST|OSMOTOOL_ANNOTATE_BENCHMARK' { cpus = 16; memory = { 16.GB * task.attempt }; time = { 4.h * task.attempt } }
    withName: 'BENCHMARK_SIMULATE_CALIB|BENCHMARK_SIMULATE_TEST|BENCHMARK_METRICS_CALIB|BENCHMARK_METRICS_TEST|BENCHMARK_ANNOTATESCORE|SPLIT_REFS' { memory = { 8.GB * task.attempt }; time = { 2.h * task.attempt } }
    withName: REFS_FETCH       { cpus = 4;  memory = 8.GB;                time = 8.h }
    withName: 'REFS_PURITY|REFS_BACKGROUND' { cpus = 8; memory = { 16.GB * task.attempt }; time = { 4.h * task.attempt } }
    withName: REFS_REFSEQ      { memory = 8.GB;                           time = 4.h }
    withName: OSMOTOOL_BUILDCATALOG { cpus = 16; memory = { 24.GB * task.attempt }; time = { 6.h * task.attempt } }
    withName: CATALOG_SCREEN   { memory = 8.GB;                           time = 30.min }
    withName: BACDIVE_ANNOTATE { cpus = 2;  memory = { 4.GB * task.attempt };  time = { 1.h * task.attempt } }
    withName: BACDIVE_MATRIX   { memory = { 8.GB * task.attempt };      time = { 1.h * task.attempt } }
    withName: BACDIVE_ANALYZE  { cpus = 4;  memory = { 16.GB * task.attempt }; time = { 2.h * task.attempt } }
    withName: NACL_MODEL       { cpus = 8;  memory = { 16.GB * task.attempt }; time = { 3.h * task.attempt } }
    withName: OSMOTOOL_ANNOTATE_GENOME { cpus = 2;  memory = { 4.GB * task.attempt };  time = { 1.h * task.attempt } }
    withName: 'OSMOTOOL_PROFILE_RECALL|HMMER_HMMSCAN' { cpus = 4;  memory = { 8.GB * task.attempt };  time = { 2.h * task.attempt } }
    withName: PROVENANCE       { memory = 4.GB;                           time = 30.min }
    withName: OSMOTOOL_PROFILE { cpus = 8;  memory = { 32.GB * task.attempt }; time = { 6.h * task.attempt } }
}

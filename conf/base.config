// Resources. The labels are the nf-core resource classes (cut to what this pipeline needs); the steps
// below them carry the values the old sbatch scripts had: measured on the laptop where a measurement
// exists, scaled from it otherwise (basis: docs/hpc.md). A task killed for memory or time is retried
// with more (x attempt); the release build is the exception, since a failed build leaves a partial release.

process {
    cpus          = 1
    memory        = { 4.GB * task.attempt }
    time          = { 1.h * task.attempt }
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 271] ? 'retry' : 'terminate' }
    maxRetries    = 2

    withLabel: process_single { cpus = 1 }
    withLabel: process_low    { cpus = 2 }
    withLabel: process_medium { cpus = 4;  memory = { 8.GB * task.attempt };  time = { 2.h * task.attempt } }
    withLabel: process_high   { cpus = 8;  memory = { 16.GB * task.attempt }; time = { 4.h * task.attempt } }

    withName: FETCH_GMGC       { memory = 4.GB;                           time = { 4.h * task.attempt } }
    withName: FETCH_BACDIVE    { cpus = 8;  memory = 8.GB;                time = { 8.h * task.attempt } }
    withName: INDEX_CATALOG    { memory = { 32.GB * task.attempt };       time = { 6.h * task.attempt } }
    withName: BACDIVE_PROTEINS { cpus = 4;  memory = { 8.GB * task.attempt };  time = { 2.h * task.attempt } }
    withName: 'ALIGN_FAMILIES|BUILD_HMMS|BUILD_DIAMOND|RUN_CALIB|RUN_TEST|BENCHMARK_ANNOTATE' { cpus = 16; memory = { 16.GB * task.attempt }; time = { 4.h * task.attempt } }
    withName: 'SIMULATE_CALIB|SIMULATE_TEST|METRICS_CALIB|METRICS_TEST|SPLIT_REFS' { memory = { 8.GB * task.attempt }; time = { 2.h * task.attempt } }
    withName: RELEASE_REFS     { cpus = 8;  memory = 16.GB;               time = 8.h }
    withName: ASSEMBLE_RELEASE { memory = 4.GB;                           time = 30.min; errorStrategy = 'terminate' }
    withName: ANNOTATE_CATALOG { cpus = 16; memory = { 24.GB * task.attempt }; time = { 6.h * task.attempt } }
    withName: SCREEN           { memory = 8.GB;                           time = 30.min }
    withName: BACDIVE_ANNOTATE { cpus = 2;  memory = { 4.GB * task.attempt };  time = { 1.h * task.attempt } }
    withName: ANALYZE_NACL     { cpus = 8;  memory = { 16.GB * task.attempt }; time = { 3.h * task.attempt } }
    withName: ANNOTATE_GENOME  { cpus = 2;  memory = { 4.GB * task.attempt };  time = { 1.h * task.attempt } }
    withName: REAL_READ_RECALL { cpus = 4;  memory = { 8.GB * task.attempt };  time = { 2.h * task.attempt } }
    withName: PROVENANCE       { memory = 4.GB;                           time = 30.min }
    withName: PROFILE_SAMPLE   { cpus = 8;  memory = { 32.GB * task.attempt }; time = { 6.h * task.attempt } }
}

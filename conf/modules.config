// Per-step settings other than resources (those are in base.config): the options each tool module
// is called with (ext.args, ext.prefix), where results are published, and storeDir. The container of
// each step is declared in its module, its packages in the module's environment.yml.
//
// A module used in more than one place is included under an alias (OSMOTOOL_ANNOTATE as
// OSMOTOOL_ANNOTATE_GENOME, ...), and the alias is what is configured here.
//
// Publishing. Steps pass their outputs to each other directly; nothing reads a published file. The
// release is published by the steps that make its parts, into releases/<release>/ under repo (the
// patterns name the release build's steps, so the marker build's SPLIT_REFS and DIAMOND_* publish nothing):
//   refs/                         SPLIT_REFS, DIAMOND_EXTRAREFS, HMM_DECOYSELECT and CDHIT_DECOY (HMM decoys)
//   alignments/                                                 MAFFT_ALIGN, TRIMAL (and their decoy aliases)
//   markers/                                                    MARKERS_PACKAGE
//   hmms/ qc_scorecard.tsv                                      HMM_CALIBRATE
//   osmo_refdb.dmnd, cutoffs, excluded families, train refs     DIAMOND_MAKEDB, _CALIBRATE, _TRAINREFS
//   osmo_refdb.profile_cascade.tsv, ..._report_levels.tsv      BENCHMARK_METRICS_CALIB
//   results/calib_metrics/ results/metrics/ results/annotate/   the benchmark
//   results/catalog_benchmark/                                  BENCHMARK_CATALOGSCORE
//   catalogs/<name>/ (+ screen.tsv)                             CATALOG_PACKAGE, CATALOG_SCREEN
//   real_genome_validation/                                     the real-genome checks
//   phenotype_validation/ nacl_model_build/ nacl_model/         BacDive and the NaCl model
//   PROVENANCE.json software_versions.yml                       PROVENANCE
// The BacDive tables and harvested batches (release-independent) go to <repo>/<data_dir>.

process {

    // ---- the release build
    withName: '.*:RELEASE_BUILD:SPLIT_REFS' {
        publishDir = [ path: { "${params.repo}/releases/${params.release}" }, mode: params.publish_dir_mode,
                       pattern: 'refs' ]
    }
    withName: '.*:RELEASE_BUILD:DIAMOND_BUILD:DIAMOND_EXTRAREFS' {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/refs" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.substring('extra/'.length()) } ]
    }
    withName: '.*:RELEASE_BUILD:DIAMOND_BUILD:DIAMOND_(TRAINREFS|MAKEDB|CALIBRATE|SCOPE)' {
        publishDir = [ path: { "${params.repo}/releases/${params.release}" }, mode: params.publish_dir_mode ]
    }
    withName: DIAMOND_BLASTP {
        // the calibration searches: every hit, at the most permissive settings (08b)
        ext.args = '--outfmt 6 qseqid sseqid bitscore --id 0 --query-cover 0 --evalue 10 --max-target-seqs 0 --quiet'
    }
    withName: REFS_CLUSTER {
        ext.args = '-c 0.90 -n 5 -M 16000 -d 0'
    }
    withName: 'MAFFT_ALIGN|TRIMAL|MAFFT_ALIGN_DECOY|TRIMAL_DECOY' {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/alignments" }, mode: params.publish_dir_mode ]
    }
    withName: 'HMM_DECOYSELECT|CDHIT_DECOY' {
        // the HMM decoys' input and clustered sets
        publishDir = [ path: { "${params.repo}/releases/${params.release}/refs" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.tokenize('/').last() } ]
    }
    withName: MARKERS_PACKAGE {
        publishDir = [ path: { "${params.repo}/releases/${params.release}" }, mode: params.publish_dir_mode ]
    }
    withName: HMM_CALIBRATE {
        publishDir = [ path: { "${params.repo}/releases/${params.release}" }, mode: params.publish_dir_mode ]
    }
    withName: BENCHMARK_METRICS_CALIB {
        publishDir = [ path: { "${params.repo}/releases/${params.release}" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f == 'metrics' ? 'results/calib_metrics'
                                    : f.startsWith('cascade/') ? f.substring('cascade/'.length()) : f } ]
    }
    withName: BENCHMARK_METRICS_TEST {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/results" }, mode: params.publish_dir_mode ]
    }
    withName: BENCHMARK_ANNOTATESCORE {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/results" }, mode: params.publish_dir_mode ]
    }
    withName: BENCHMARK_CATALOGSCORE {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/results" }, mode: params.publish_dir_mode ]
    }

    // ---- alignments: one family per task
    withName: 'MAFFT_ALIGN|MAFFT_ALIGN_DECOY' {
        ext.args = '--auto'
    }
    withName: 'TRIMAL|TRIMAL_DECOY' {
        ext.args = { "-gt ${meta.trim_gt}" }
    }
    withName: CDHIT_DECOY {
        ext.args   = '-c 0.90 -n 5 -M 16000 -d 0'
        ext.prefix = { "${meta.id}.hmm_decoy.clustered" }
    }

    // ---- the read benchmark
    withName: BENCHMARK_SIMULATE_TEST {
        ext.args = { params.read_lengths ? "--read-lengths ${params.read_lengths}" : '' }
    }
    withName: OSMOTOOL_BUILDCATALOG_BENCHMARK {
        // the catalog benchmark's catalogs (meta.index: all, or hits as a release ships)
        ext.args   = { "--index ${meta.index}" }
        ext.prefix = { meta.id }
    }
    withName: BENCHMARK_CATALOGMAP {
        // the verify runs use the read benchmark's DIAMOND filter
        ext.args = { "--min_subject_cover ${params.diamond_min_subject_cover}" }
    }
    withName: 'BENCHMARK_READS_CALIB|BENCHMARK_READS_TEST' {
        // calibration and test reads under the same filter, so the cascade is decided for what is scored
        ext.args = { "DIAMOND_MIN_SUBJECT_COVER=${params.diamond_min_subject_cover}" }
    }

    // ---- the release build's annotate benchmark: one run per method (meta.method)
    withName: OSMOTOOL_ANNOTATE_BENCHMARK {
        ext.args = { "--method ${meta.method}" }
    }

    // ---- the catalog
    withName: OSMOTOOL_INDEXCATALOG {
        // the full index of every catalog gene; classic bwa, since bwa-mem3 would need 100+ GB
        ext.args  = '--aligner bwa'
        ext.prefix = { new File(params.full_index_dir.toString()).name }
        // built here, moved to full_index_dir when complete (never half there); skipped if it exists
        storeDir   = { new File(params.full_index_dir.toString()).parent }
    }
    withName: OSMOTOOL_BUILDCATALOG {
        // the small hits-only index ships with the release
        ext.args   = '--index hits'
        ext.prefix = { params.catalog_name }
    }
    withName: CATALOG_PACKAGE {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/catalogs" }, mode: params.publish_dir_mode ]
    }
    withName: CATALOG_SCREEN {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/catalogs/${params.catalog_name}" }, mode: params.publish_dir_mode,
                       pattern: 'screen.tsv' ]
    }

    // ---- BacDive (release-independent data, then the analysis on the release)
    withName: BACDIVE_HARVEST {
        // the tables and the batches (the genomes, 9 GB, stay in the work directory for -resume)
        publishDir = [ path: { "${params.repo}/${params.data_dir}" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.replaceFirst('^bacdive/', '') } ]
    }

    // ---- the random-panel pool (fixed: assets/random_panel/pool_families.tsv)
    withName: POOL_EXTRACT {
        publishDir = [ path: { "${params.repo}/${params.data_dir}/random_panel" }, mode: params.publish_dir_mode ]
    }
    withName: POOL_PFAM {
        publishDir = [ path: { "${params.repo}/${params.data_dir}/random_panel" }, mode: params.publish_dir_mode,
                       pattern: 'Pfam.version' ]
    }
    withName: BACDIVE_ANNOTATE {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/phenotype_validation" }, mode: params.publish_dir_mode,
                       saveAs: { f -> f.startsWith('control_annotate/')
                                    ? "strategy_control/annotate/${f.substring('control_annotate/'.length())}" : f } ]
    }
    withName: 'BACDIVE_MATRIX|BACDIVE_ANALYZE' {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/phenotype_validation" }, mode: params.publish_dir_mode ]
    }
    withName: NACL_MODEL {
        publishDir = [ path: { "${params.repo}/releases/${params.release}" }, mode: params.publish_dir_mode ]
    }

    // ---- real-genome validation
    withName: OSMOTOOL_ANNOTATE_GENOME {
        ext.args = '--keep_proteins'
    }
    withName: WGSIM {
        ext.args = { "-S 1 -N ${params.recall_read_pairs} -1 150 -2 150" }
    }
    withName: OSMOTOOL_PROFILE_RECALL {
        // the benchmark's permissive DIAMOND filters; no copies-per-genome normalisation
        ext.args = '--min_identity 0.40 --min_query_cover 0.50 --keep_aln --no_markers'
    }
    withName: HMMER_HMMSCAN {
        ext.prefix = { "${meta.id}.reads" }
    }
    withName: 'VALIDATION_CHECKSYSTEMS|VALIDATION_READRECALL|OSMOTOOL_PROFILE_RECALL|HMMER_HMMSCAN' {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/real_genome_validation" }, mode: params.publish_dir_mode ]
    }

    // ---- the receipt
    withName: PROVENANCE {
        publishDir = [ path: { "${params.repo}/releases/${params.release}" }, mode: params.publish_dir_mode ]
    }

    // ---- -entry profile_samples
    withName: OSMOTOOL_PROFILE {
        ext.args   = { "--catalog ${params.catalog_name} --keep_aln" }
        publishDir = [ path: { "${params.outdir}/profile" }, mode: params.publish_dir_mode ]
    }
}

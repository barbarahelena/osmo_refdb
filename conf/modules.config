// Per-step settings other than resources (those are in base.config). The container of each step is
// declared in its module (containers/README.md says what each needs).

process {
    withName: 'CHECK_REFERENCE_SYSTEMS|REAL_READ_RECALL' {
        publishDir = [ path: { "${params.repo}/releases/${params.release}/real_genome_validation" }, mode: 'copy' ]
    }
    withName: PROFILE_SAMPLE {
        publishDir = [ path: { "${params.outdir}/profile" }, mode: 'copy' ]
    }
}

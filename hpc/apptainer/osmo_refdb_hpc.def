# Apptainer image for the osmo_refdb pipeline and osmotool (profile --catalog).
#
# Build on a login/build node WITH internet access (compute nodes usually have
# none), from the osmo_refdb repo root, so environment.yml is found:
#
#   apptainer build --fakeroot osmo_refdb_hpc.sif hpc/apptainer/osmo_refdb_hpc.def
#   # another osmotool branch or tag:
#   apptainer build --fakeroot --build-arg OSMOTOOL_REF=v0.9.0 osmo_refdb_hpc.sif hpc/apptainer/osmo_refdb_hpc.def
#
# --build-arg needs Apptainer >= 1.2; on older versions edit OSMOTOOL_REF below.
# If --fakeroot is not allowed on your cluster, build the same recipe
# elsewhere (e.g. `apptainer build --remote`) or ask your admins.
#
# Not tested on a cluster yet: the steps mirror the repo's Dockerfile, plus
# bwa-mem3 (in environment.yml), which needs AVX2 on x86-64 (or ARM NEON).
Bootstrap: docker
From: continuumio/miniconda3:24.1.2-0

%arguments
    OSMOTOOL_REF=catalog-profile

%files
    environment.yml /opt/osmo_refdb/environment.yml

%post
    apt-get update && apt-get install -y --no-install-recommends procps git time \
        && rm -rf /var/lib/apt/lists/*
    conda env create -f /opt/osmo_refdb/environment.yml
    conda clean -afy
    # osmotool from git (no PyPI release with catalog support yet)
    conda run -n osmo_refdb pip install --no-deps \
        "git+https://github.com/barbarahelena/osmotool.git@{{ OSMOTOOL_REF }}"

%environment
    export PATH=/opt/conda/envs/osmo_refdb/bin:$PATH
    export LC_ALL=C

%runscript
    exec "$@"

%labels
    Description osmo_refdb pipeline and osmotool, with bwa-mem3 for gene catalogs

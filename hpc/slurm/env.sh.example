# Copy to env.sh, edit, and `source` it in your shell before sbatch-ing the
# scripts in this directory (sbatch passes the environment on).

# the image built from hpc/apptainer/osmo_refdb_hpc.def
export SIF=$HOME/osmo_refdb_hpc.sif
# a clone of osmo_refdb (branch release-catalog or later) that contains
# releases/<RELEASE>/ (see hpc/README.md for what to copy there)
export REPO=$HOME/osmo_refdb
export RELEASE=v10
# the catalog: name used by `profile --catalog NAME`, and its gene FASTA
export CATALOG_NAME=gmgc_gut
export CATALOG_GENES=/path/to/GMGC10.human-gut.95nr.0.5.percent.prevalence.fna.gz
export CATALOG_SOURCE="GMGC v1.0 human gut, prevalence > 0.5% (Ducarmon et al., Cayman)"
export CATALOG_SOURCE_URL=https://zenodo.org/records/10473258
# where the separately built full index goes (release-independent)
export FULL_INDEX_DIR=/path/to/gmgc_gut_full_index
# release-independent BacDive data (genomes, cached proteins, random panel): inside the repo, so the
# /work bind covers it. Put the snapshot files (bacdive_raw/, random_panel/pool.hmm, pool_families.tsv,
# Pfam.version, pilot_strains.tsv) here before launching; see hpc/README.md.
export DATA_DIR=data/phenotype_validation
export NCHUNKS=40                    # SLURM array tasks for the per-genome steps
# fast node-local or scratch space for temporary files, if your site has it
export APPTAINER_BIND="$REPO:/work,${CATALOG_GENES%/*}:${CATALOG_GENES%/*},${FULL_INDEX_DIR%/*}:${FULL_INDEX_DIR%/*}"

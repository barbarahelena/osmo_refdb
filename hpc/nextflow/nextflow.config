// Settings for hpc/nextflow/main.nf. Values you set per run go in a params file (params.example.yaml).
//
// Where it runs is decided by the profile:
//   (none)         the default profile `standard` below: SLURM + Apptainer, generic
//   <institution>  a profile from nf-core/configs (see the end of this file), which brings its own
//                  executor, queue, limits and container engine. It replaces `standard`.
//   local          no SLURM, no containers: -stub-run on a laptop

manifest {
    name            = 'osmo_refdb-hpc'
    description     = 'osmo_refdb canonical build, catalog, BacDive and NaCl model on SLURM + Apptainer'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    // ---- required: set them in a params file
    repo            = null     // a clone of osmo_refdb at the commit to build, absolute path
    release         = null     // the NEW release's name; releases/<release> must not exist yet
    reuse_refs_from = null     // the snapshot to build from, e.g. releases/v10 (relative to repo)
    catalog_genes   = null     // <dir>/GMGC10.human-gut.95nr.0.5.percent.prevalence.fna.gz, absolute path
    full_index_dir  = null     // where the full catalog index goes, absolute path

    // ---- with defaults
    outdir             = 'results'                     // -entry profile_samples writes <outdir>/profile
    catalog_name       = 'gmgc_gut'
    catalog_source     = 'GMGC v1.0 human gut, prevalence > 0.5% (Ducarmon et al., Cayman)'
    catalog_source_url = 'https://zenodo.org/records/10473258'
    catalog_force      = false
    data_dir           = 'data/phenotype_validation'   // release-independent BacDive data, under repo
    nchunks            = 40                            // tasks per per-genome step
    split_mode         = 'random'                      // random | taxonomy
    gate_passed        = false                         // true: also run BacDive + the NaCl model
    samples            = null                          // -entry profile_samples: CSV with id,r1,r2

    // ---- the cluster (used by the default profile; an institutional profile sets its own)
    queue          = null      // SLURM partition; null = the cluster's default
    slurm_extra    = ''        // e.g. '--account=myproject --qos=normal'
    extra_binds    = ''        // comma-separated directories outside repo that jobs read or write
    work_dir       = null      // Nextflow's work directory; null = ./work (use scratch if repo is in $HOME)

    // ---- institutional profiles (nf-core/configs), pinned to a commit so a rerun does not depend on
    // a file that moves; to update, change the commit. Needs the network when Nextflow starts;
    // --custom_config_base can point at a local clone of nf-core/configs, NXF_OFFLINE=true skips it.
    custom_config_version = '0a2d887d8373bbf0746abd3eb3c4b0ca686c825f'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

workDir = params.work_dir ?: "${launchDir}/work"

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// The repo is mounted at the same path inside the container, so every path in a params file means
// the same thing in both places. Set for both engines: whichever the profile enables picks it up.
apptainer   { runOptions = "--bind ${params.repo ?: '.'}" + (params.extra_binds ? ",${params.extra_binds}" : '') }
singularity { runOptions = "--bind ${params.repo ?: '.'}" + (params.extra_binds ? ",${params.extra_binds}" : '') }

// What the trace records per task (including its image), for tightening the numbers in conf/base.config. The files themselves
// are switched on, one set per invocation, by run_nextflow.sbatch (-with-trace ...), so the run after the
// gate does not overwrite the first run's measurements.
trace {
    fields = 'task_id,name,container,status,exit,submit,realtime,cpus,%cpu,memory,peak_rss,peak_vmem'
}

profiles {
    // generic SLURM + Apptainer; used when no -profile is given
    standard {
        apptainer {
            enabled    = true
            autoMounts = true
        }
        process {
            executor       = 'slurm'
            queue          = params.queue
            clusterOptions = params.slurm_extra
        }
    }

    // no SLURM, no container engine: for -stub-run on a laptop or for developing the workflow
    local {
        process {
            executor       = 'local'
            resourceLimits = [cpus: 4, memory: 6.GB, time: 1.h]   // fit a laptop VM
        }
    }
}

// Institutional profiles from nf-core/configs: `-profile <your institution>` sets the executor, queue,
// resource limits and container engine for a site, in place of `standard` above.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"
